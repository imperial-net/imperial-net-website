# ============================================================
# IMPERIAL-NET — .htaccess de la RAÍZ del servidor (public_html)
# ------------------------------------------------------------
# IMPORTANTE: este archivo va en la RAÍZ del hosting (public_html),
# NO dentro de dist/. Sirve el sitio desde la subcarpeta dist/ para
# que puedas subir la carpeta dist COMPLETA, sin tener que vaciarla.
#
# Estructura esperada en el servidor:
#   public_html/
#   ├── .htaccess        <-- ESTE archivo
#   ├── dist/            <-- la carpeta tal cual sale del build (astro build)
#   ├── services/        <-- el backend PHP (formulario de contacto)
#   └── env-config.php   <-- credenciales de mail (NO accesible por web)
# ============================================================

RewriteEngine On

# --- 1) Forzar HTTPS ---
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# --- 2) Dejar el backend PHP en la raíz (NO reescribir /services/...) ---
RewriteRule ^services/ - [L]

# --- 3) Servir todo lo demás desde dist/ ---
# Si la URL ya apunta a dist/, no reescribir otra vez (evita bucles).
RewriteCond %{REQUEST_URI} !^/dist/
RewriteRule ^(.*)$ dist/$1 [L]

# ============================================================
# SEGURIDAD
# ============================================================

# Bloquear acceso a archivos sensibles
<FilesMatch "^\.env|\.env\..+|\.git|composer\.(json|lock)|package(-lock)?\.json|tsconfig\.json|astro\.config\..+|\.htpasswd|env-config\.php">
    Require all denied
</FilesMatch>

# Bloquear acceso a directorios/archivos ocultos (empiezan con punto)
RedirectMatch 403 /\..*

# Bloquear listado de directorios
Options -Indexes

# Cabeceras de seguridad
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# ============================================================
# PERFORMANCE
# ============================================================

# Cache para assets estáticos (mejora performance)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType video/mp4 "access plus 1 month"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType application/json "access plus 0 seconds"
</IfModule>

# Comprimir recursos de texto (gzip)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json text/xml
</IfModule>
