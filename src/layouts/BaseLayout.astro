---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
const { title, description } = Astro.props;
---

<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- Canonical URL -->
  <link rel="canonical" href={`https://imperial-net.com${Astro.url.pathname}`} />

  <!-- Title and Description -->
  <title>{title || "Imperial Net | Soluciones Digitales y Software a Medida para PyMEs"}</title>
  <meta name="description" content={description || "Transforma tu empresa con Imperial Net: desarrollo de software a medida, automatización, consultoría tecnológica y digitalización para PyMEs. ¡Potencia tu negocio hoy!"} />

  <!-- SEO Keywords -->
  <meta name="keywords" content="software a medida, desarrollo web, automatización, PyME, digitalización, sistemas empresariales, Imperial Net, soluciones digitales, consultoría tecnológica, transformación digital, innovación, tecnología" />

  <!-- Author -->
  <meta name="author" content="Imperial Net" />

  <!-- Robots -->
  <meta name="robots" content="index, follow" />

  <!-- Open Graph (para Facebook, LinkedIn, WhatsApp) -->
  <meta property="og:title" content="Imperial Net | Soluciones Digitales y Software a Medida para PyMEs" />
  <meta property="og:description" content="Transforma tu empresa con Imperial Net: desarrollo de software a medida, automatización, consultoría tecnológica y digitalización para PyMEs. ¡Potencia tu negocio hoy!" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://imperial-net.com/" />
  <meta property="og:image" content="https://imperial-net.com/img/logo.webp" />
  <meta property="og:image:alt" content="Logo Imperial Net" />
  <meta property="og:image:type" content="image/webp" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="1200" />
  <meta property="og:site_name" content="Imperial Net" />

  <!-- Twitter Card (para Twitter/X) -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Imperial Net | Soluciones Digitales y Software a Medida para PyMEs" />
  <meta name="twitter:description" content="Transforma tu empresa con Imperial Net: desarrollo de software a medida, automatización, consultoría tecnológica y digitalización para PyMEs. ¡Potencia tu negocio hoy!" />
  <meta name="twitter:image" content="https://imperial-net.com/img/logo.webp" />
  <meta name="twitter:image:alt" content="Logo Imperial Net" />

  <!-- Favicon -->
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
    <!-- Datos estructurados para SEO -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "Imperial Net",
      "url": "https://imperial-net.com/",
      "logo": "https://imperial-net.com/img/logo.webp",
      "description": "Transforma tu empresa con Imperial Net: desarrollo de software a medida, automatización, consultoría tecnológica y digitalización para PyMEs.",
      "sameAs": [
        "https://www.facebook.com/imperialnet",
        "https://www.linkedin.com/company/imperialnet/"
      ]
    }
    </script>
    
    <!-- Structured Data (Google Rich Snippets) -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "Imperial Net",
        "url": "https://imperial-net.com",
        "logo": "https://imperial-net.com/img/logo.webp",
        "description": "Desarrollo de software a medida y soluciones digitales para PyMEs.",
        "sameAs": [
          "https://www.linkedin.com/company/imperialnet",
          "https://www.instagram.com/imperialnet"
        ]
      }
    </script>

  <!-- Preconnect a CDNs externos para mejorar performance -->
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
  <link rel="preconnect" href="https://unpkg.com" crossorigin>

  <!-- Bootstrap Icons -->
  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css"
    media="print" onload="this.media='all'"
  />

  <!-- Animaciones CSS -->
  <link rel="stylesheet" href="https://unpkg.com/@animxyz/core" media="print" onload="this.media='all'" />

  <!-- AOS CSS -->
  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.css"
    media="print" onload="this.media='all'"
  />
</head>


  <body>
    <Navbar />

    <main style="margin-top: 80px;">
      <slot />
      <WhatsAppButton />
    </main>

    <!-- Cargar AOS y luego inicializar -->
    <script src="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.js" defer onload="AOS.init({ duration: 1000, once: false });"></script>

    <!-- Bootstrap JS -->
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
      defer
      crossorigin="anonymous"
    ></script>

  </body>
</html>
