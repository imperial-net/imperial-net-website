---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
const { title, description } = Astro.props;
---

<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- Canonical URL -->
  <link rel="canonical" href={`https://imperial-net.com${Astro.url.pathname}`} />

  <!-- Title and Description -->
  <title>{title || "Imperial Net | Software a Medida en Trenque Lauquen | Desarrollo Web"}</title>
  <meta name="description" content={description || "Desarrollo de software a medida, sitios web y páginas web en Trenque Lauquen. Imperial Net: automatización, digitalización y soluciones digitales para PyMEs. ¡Potencia tu negocio!"} />

  <!-- SEO Keywords -->
  <meta name="keywords" content="software a medida, desarrollo web, automatización, PyME, digitalización, sistemas empresariales, Imperial Net, soluciones digitales, consultoría tecnológica, transformación digital, innovación, tecnología, sitios web Trenque Lauquen, páginas web Trenque Lauquen, software Trenque Lauquen, programas Trenque Lauquen, software a medida Trenque Lauquen, desarrollo web Trenque Lauquen, diseño web Trenque Lauquen, aplicaciones Trenque Lauquen" />

  <!-- Author -->
  <meta name="author" content="Imperial Net" />

  <!-- Robots -->
  <meta name="robots" content="index, follow" />

  <!-- Open Graph (para Facebook, LinkedIn, WhatsApp) -->
  <meta property="og:title" content="Imperial Net | Soluciones Digitales y Software a Medida para PyMEs" />
  <meta property="og:description" content="Transforma tu empresa con Imperial Net: desarrollo de software a medida, automatización, consultoría tecnológica y digitalización para PyMEs. ¡Potencia tu negocio hoy!" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://imperial-net.com/" />
  <meta property="og:image" content="https://imperial-net.com/img/logo.webp" />
  <meta property="og:image:alt" content="Logo Imperial Net" />
  <meta property="og:image:type" content="image/webp" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="1200" />
  <meta property="og:site_name" content="Imperial Net" />

  <!-- Twitter Card (para Twitter/X) -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Imperial Net | Soluciones Digitales y Software a Medida para PyMEs" />
  <meta name="twitter:description" content="Transforma tu empresa con Imperial Net: desarrollo de software a medida, automatización, consultoría tecnológica y digitalización para PyMEs. ¡Potencia tu negocio hoy!" />
  <meta name="twitter:image" content="https://imperial-net.com/img/logo.webp" />
  <meta name="twitter:image:alt" content="Logo Imperial Net" />

  <!-- Favicon -->
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
    <!-- Datos estructurados para SEO - Organization (para el logo en Google) -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "Imperial Net",
    "url": "https://imperial-net.com",
    "logo": {
      "@type": "ImageObject",
      "url": "https://imperial-net.com/img/logo.webp",
      "width": 1200,
      "height": 1200
    },
    "description": "Desarrollo de software a medida, sitios web y soluciones digitales para PyMEs en Trenque Lauquen y alrededores.",
    "sameAs": [
      "https://www.linkedin.com/company/imperialnet",
      "https://www.instagram.com/imperialnet",
      "https://www.facebook.com/imperialnet"
    ],
    "contactPoint": {
      "@type": "ContactPoint",
      "contactType": "Customer Service",
      "availableLanguage": "Spanish"
    }
  }
  </script>

  <!-- LocalBusiness Schema (para SEO local en Trenque Lauquen) -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": "Imperial Net",
    "image": "https://imperial-net.com/img/logo.webp",
    "url": "https://imperial-net.com",
    "telephone": "+54-9-2392-556779",
    "priceRange": "$$",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Trenque Lauquen",
      "addressLocality": "Trenque Lauquen",
      "addressRegion": "Buenos Aires",
      "addressCountry": "AR"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": -35.9735,
      "longitude": -62.7364
    },
    "openingHoursSpecification": {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": [
        "Monday",
        "Tuesday",
        "Wednesday",
        "Thursday",
        "Friday"
      ],
      "opens": "09:00",
      "closes": "18:00"
    },
    "sameAs": [
      "https://www.linkedin.com/company/imperialnet",
      "https://www.instagram.com/imperialnet",
      "https://www.facebook.com/imperialnet"
    ],
    "areaServed": {
      "@type": "City",
      "name": "Trenque Lauquen"
    },
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Servicios de Software y Desarrollo Web",
      "itemListElement": [
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Desarrollo de Software a Medida",
            "description": "Software personalizado para PyMEs en Trenque Lauquen"
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Desarrollo de Sitios Web",
            "description": "Diseño y desarrollo de páginas web profesionales"
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Automatización de Procesos",
            "description": "Automatización y digitalización de procesos empresariales"
          }
        }
      ]
    }
  }
  </script>

  <!-- Preconnect a CDNs externos para mejorar performance -->
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
  <link rel="preconnect" href="https://unpkg.com" crossorigin>

  <!-- Bootstrap Icons -->
  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css"
    media="print" onload="this.media='all'"
  />

  <!-- Animaciones CSS -->
  <link rel="stylesheet" href="https://unpkg.com/@animxyz/core" media="print" onload="this.media='all'" />

  <!-- AOS CSS -->
  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.css"
    media="print" onload="this.media='all'"
  />
</head>


  <body>
    <Navbar />

    <main style="margin-top: 80px;">
      <slot />
      <WhatsAppButton />
    </main>

    <!-- Cargar AOS y luego inicializar -->
    <script src="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.js" defer onload="AOS.init({ duration: 1000, once: false });"></script>

    <!-- Bootstrap JS -->
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
      defer
      crossorigin="anonymous"
    ></script>

  </body>
</html>
