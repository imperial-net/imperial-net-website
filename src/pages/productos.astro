---
import Layout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="Productos | Imperial Net — Ficus, QRest e Inventory Desktop"
  description="Conocé los productos de Imperial Net: Ficus, el sistema de gestión para comercios con stock, ventas y reportes desde el celular; QRest, el sistema administrativo para restaurantes con mesas, pedidos y carta digital QR; e Inventory Desktop, gestión de inventario y ventas para PyMEs con escáner incluido."
>

<section class="products-page-hero">
  <div class="container text-center" data-reveal-stagger>
    <div class="page-badge">
      <i class="bi bi-box-seam"></i>
      <span>Productos Destacados</span>
    </div>
    <h1 class="page-title">
      Soluciones <span class="text-grad">listas para usar</span>
    </h1>
    <p class="page-subtitle">
      Productos desarrollados por Imperial Net para resolver problemas reales de PyMEs argentinas
    </p>
  </div>
</section>

<!-- QRest -->
<section id="qrest" class="product-detail-section">
  <div class="container">
    <div class="product-detail-grid" data-reveal-stagger>

      <div class="product-detail-info">
        <div class="qrest-header">
          <img src="/img/webp/logo.webp" alt="Logo QRest" class="qrest-logo-img" loading="lazy" />
          <div>
            <div class="detail-badge web">
              <i class="bi bi-globe"></i> Plataforma Web
            </div>
            <h2 class="detail-title">QRest</h2>
          </div>
        </div>

        <p class="detail-desc">
          Sistema administrativo web para restaurantes, bares y locales gastronómicos. Gestioná el salón completo desde un solo lugar: estado de mesas, pedidos, cuentas por mesa, productos y reportes de ingresos, todo en tiempo real.
        </p>
        <p class="detail-desc">
          Incluye además carta digital con QR: tus clientes escanean desde su celular y ven el menú al instante, sin app y sin papel. Actualizás precios, platos y fotos desde el mismo panel.
        </p>

        <div class="detail-features">
          <div class="df-item"><i class="bi bi-check-circle-fill"></i><span>Control de mesas y ocupación en tiempo real</span></div>
          <div class="df-item"><i class="bi bi-check-circle-fill"></i><span>Gestión de pedidos y cuentas por mesa</span></div>
          <div class="df-item"><i class="bi bi-check-circle-fill"></i><span>Administración de productos y categorías</span></div>
          <div class="df-item"><i class="bi bi-check-circle-fill"></i><span>Reportes de ingresos y estadísticas</span></div>
          <div class="df-item"><i class="bi bi-check-circle-fill"></i><span>Carta digital pública vía código QR</span></div>
          <div class="df-item"><i class="bi bi-check-circle-fill"></i><span>100% web: entrás desde cualquier dispositivo</span></div>
        </div>

        <div class="detail-actions">
          <a href="https://qrest.com.ar" target="_blank" rel="noopener noreferrer" class="btn-detail-primary">
            <i class="bi bi-box-arrow-up-right"></i> Visitar QRest
          </a>
          <a href="https://wa.me/5492392556779?text=Hola,%20quiero%20información%20sobre%20QRest" target="_blank" rel="noopener noreferrer" class="btn-detail-whatsapp">
            <i class="bi bi-whatsapp"></i> Consultar por WhatsApp
          </a>
        </div>
      </div>

      <div class="product-detail-visual">
        <div class="qrest-visual-layout">
          <div class="qrest-mobile-frame">
            <img src="/img/qrest/screeshot-carta.webp" alt="QRest - carta digital vista cliente" loading="lazy" />
          </div>
          <div class="qrest-desktop-frame">
            <img src="/img/webp/qrest-2.webp" alt="QRest - panel de administración" loading="lazy" />
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<div class="section-divider"></div>

<!-- Inventory Desktop -->
<section id="inventory" class="product-detail-section">
  <div class="container">
    <div class="product-detail-grid reverse" data-reveal-stagger>

      <div class="product-detail-info">
        <div class="detail-badge offer">
          <i class="bi bi-lightning-charge-fill"></i> Oferta Limitada
        </div>
        <h2 class="detail-title" style="margin-top: 0.5rem;">Inventory Desktop</h2>
        <p class="detail-desc">
          Inventory Desktop es un sistema de escritorio para gestión de inventario y ventas, diseñado especialmente para comercios y PyMEs que necesitan controlar su stock con precisión. Registrá entradas y salidas, facturá ventas, y consultá reportes sin complicaciones.
        </p>
        <p class="detail-desc">
          Se entrega con instalación incluida y configurado para tu negocio. Sin suscripciones, sin nubes, sin costos extra.
        </p>

        <div class="detail-features">
          <div class="df-item"><i class="bi bi-check-circle-fill"></i><span>Gestión completa de stock</span></div>
          <div class="df-item"><i class="bi bi-check-circle-fill"></i><span>Registro de ventas y compras</span></div>
          <div class="df-item"><i class="bi bi-check-circle-fill"></i><span>Escáner de código de barras incluido</span></div>
          <div class="df-item"><i class="bi bi-check-circle-fill"></i><span>Reportes y estadísticas</span></div>
          <div class="df-item"><i class="bi bi-check-circle-fill"></i><span>Instalación y configuración incluida</span></div>
          <div class="df-item"><i class="bi bi-check-circle-fill"></i><span>Sin costos de suscripción mensual</span></div>
        </div>

        <div class="offer-block">
          <div class="offer-label">
            <i class="bi bi-lightning-charge-fill"></i> Oferta especial — Unidades limitadas
          </div>
          <div class="offer-price">$150.000 <span>ARS</span></div>
          <div class="offer-includes">
            <i class="bi bi-check-circle-fill"></i> Incluye escáner de código de barras
          </div>
          <div class="offer-includes">
            <i class="bi bi-check-circle-fill"></i> Incluye instalación y demostración en tu local
          </div>
        </div>

        <div class="detail-actions">
          <a href="https://wa.me/5492392556779?text=Hola,%20quiero%20información%20sobre%20Inventory%20Desktop" target="_blank" rel="noopener noreferrer" class="btn-detail-whatsapp">
            <i class="bi bi-whatsapp"></i> Quiero saber más
          </a>
        </div>
      </div>

      <div class="product-detail-visual">
        <div class="screenshots-stack">
          <img src="/img/webp/inventiory-desktop-1.webp" alt="Inventory Desktop - pantalla principal" class="detail-screenshot stack-top" loading="lazy" />
          <img src="/img/webp/inventiory-desktop-2.webp" alt="Inventory Desktop - gestión de stock" class="detail-screenshot stack-bottom" loading="lazy" />
        </div>
      </div>

    </div>
  </div>
</section>

<div class="section-divider"></div>

<!-- Ficus -->
<section id="ficus" class="product-detail-section">
  <div class="container">
    <div class="product-detail-grid" data-reveal-stagger>

      <div class="product-detail-info">
        <div class="ficus-header">
          <img src="/img/ficus/ficus-logo.webp" alt="Logo Ficus" class="ficus-logo-img" loading="lazy" />
          <div>
            <div class="detail-badge web">
              <i class="bi bi-globe"></i> Plataforma Web
            </div>
            <h2 class="detail-title">Ficus</h2>
          </div>
        </div>
        <p class="detail-desc">
          Ficus es el sistema de gestión para comercios: stock, ventas, compras y los números
          del negocio en un solo lugar. Funciona desde la computadora del mostrador o desde el
          celular, sin instalar nada.
        </p>
        <p class="detail-desc">
          Pensado para el día a día de un local: escaneás o buscás el producto, cobrás, y la
          venta ya queda registrada con su stock descontado.
        </p>

        <div class="detail-features">
          <div class="df-item"><i class="bi bi-check-circle-fill"></i><span>Venta rápida con escáner o búsqueda</span></div>
          <div class="df-item"><i class="bi bi-check-circle-fill"></i><span>Control de stock y productos</span></div>
          <div class="df-item"><i class="bi bi-check-circle-fill"></i><span>Compras, gastos y cierre de caja</span></div>
          <div class="df-item"><i class="bi bi-check-circle-fill"></i><span>Clientes y cuentas corrientes</span></div>
          <div class="df-item"><i class="bi bi-check-circle-fill"></i><span>Reportes de ingresos, gastos y resultado</span></div>
          <div class="df-item"><i class="bi bi-check-circle-fill"></i><span>Desde la compu o el celular, sin instalar</span></div>
        </div>

        <div class="detail-actions">
          <a href="https://wa.me/5492392556779?text=Hola,%20quiero%20información%20sobre%20Ficus" target="_blank" rel="noopener noreferrer" class="btn-detail-whatsapp">
            <i class="bi bi-whatsapp"></i> Quiero saber más
          </a>
        </div>
      </div>

      <div class="product-detail-visual">
        <div class="ficus-shots">
          <img src="/img/ficus/ficus-inicio.webp" alt="Ficus - inicio con accesos rápidos y ventas del día" class="ficus-shot" loading="lazy" />
          <img src="/img/ficus/ficus-vender.webp" alt="Ficus - pantalla de venta rápida" class="ficus-shot ficus-shot-mid" loading="lazy" />
          <img src="/img/ficus/ficus-reportes.webp" alt="Ficus - reportes de ingresos, gastos y resultado" class="ficus-shot" loading="lazy" />
        </div>
      </div>

    </div>
  </div>
</section>

<Footer />

<style>

  /* Ficus */
  .ficus-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.2rem;
  }

  .ficus-logo-img {
    width: 64px;
    height: 64px;
    object-fit: contain;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(34, 197, 94, 0.25);
    padding: 8px;
    flex-shrink: 0;
    filter: drop-shadow(0 4px 12px rgba(34, 197, 94, 0.25));
  }

  .ficus-header .detail-badge {
    margin-bottom: 0.4rem;
  }

  .ficus-header .detail-title {
    margin-bottom: 0;
  }

  .ficus-shots {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
  }

  /* Las tres capturas son de celular: la del medio se levanta un poco para
     que el conjunto no se lea como tres imágenes sueltas. */
  .ficus-shot {
    width: 32%;
    max-width: 220px;
    height: auto;
    border-radius: 14px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.45);
  }

  .ficus-shot-mid {
    transform: translateY(-22px);
  }

  @media (max-width: 575.98px) {
    .ficus-shots {
      gap: 0.5rem;
    }

    .ficus-shot-mid {
      transform: none;
    }
  }

  .products-page-hero {
    padding: 120px 0 60px;
    background: linear-gradient(135deg, #0a0a0f 0%, #0f1419 60%, #101c2c 100%);
    color: white;
    position: relative;
  }

  .page-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: linear-gradient(135deg, rgba(0,170,255,0.2), rgba(255,255,255,0.08));
    border: 1px solid rgba(0,170,255,0.3);
    padding: 8px 20px;
    border-radius: 30px;
    color: #00aaff;
    font-weight: 600;
    font-size: 0.9rem;
    margin-bottom: 1.2rem;
  }

  .page-title {
    font-size: clamp(2.2rem, 5vw, 3.5rem);
    font-weight: 800;
    color: #fff;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }

  .text-grad {
    background: linear-gradient(135deg, #00aaff, #00ccff, #66d9ff);
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .page-subtitle {
    font-size: 1.1rem;
    color: rgba(255,255,255,0.7);
    max-width: 560px;
    margin: 0 auto;
    line-height: 1.6;
  }

  /* Detail sections */
  .product-detail-section {
    padding: 80px 0;
    background: linear-gradient(135deg, #0a0a0f 0%, #0f1419 60%, #101c2c 100%);
    color: white;
  }

  .product-detail-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
  }

  .product-detail-grid.reverse {
    direction: rtl;
  }

  .product-detail-grid.reverse > * {
    direction: ltr;
  }

  /* Badges */
  .detail-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 14px;
    border-radius: 20px;
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1rem;
    width: fit-content;
  }

  .detail-badge.web {
    background: rgba(0,170,255,0.15);
    border: 1px solid rgba(0,170,255,0.3);
    color: #00ccff;
  }

  .detail-badge.offer {
    background: rgba(255,183,0,0.15);
    border: 1px solid rgba(255,183,0,0.4);
    color: #ffb700;
    animation: pulse-offer 2.5s ease-in-out infinite;
  }

  @keyframes pulse-offer {
    0%, 100% { box-shadow: 0 0 0 0 rgba(255,183,0,0.3); }
    50% { box-shadow: 0 0 0 6px rgba(255,183,0,0); }
  }

  /* QRest header con logo */
  .qrest-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.2rem;
  }

  .qrest-logo-img {
    width: 64px;
    height: 64px;
    object-fit: contain;
    border-radius: 14px;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(0,170,255,0.2);
    padding: 8px;
    flex-shrink: 0;
    filter: drop-shadow(0 4px 12px rgba(0,170,255,0.25));
  }

  .qrest-header .detail-badge {
    margin-bottom: 0.4rem;
  }

  .qrest-header .detail-title {
    margin-bottom: 0;
  }

  /* QRest visual layout */
  .qrest-visual-layout {
    display: flex;
    flex-direction: row;
    gap: 1.2rem;
    align-items: center;
    justify-content: center;
    height: 100%;
  }

  .qrest-mobile-frame {
    width: 200px;
    flex-shrink: 0;
    border-radius: 18px;
    overflow: hidden;
    border: 1px solid rgba(0,170,255,0.2);
    box-shadow: 0 20px 50px rgba(0,0,0,0.5), 0 0 20px rgba(0,170,255,0.08);
  }

  .qrest-mobile-frame img {
    width: 100%;
    height: auto;
    display: block;
  }

  .qrest-desktop-frame {
    flex: 1;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid rgba(0,170,255,0.15);
    box-shadow: 0 10px 30px rgba(0,0,0,0.4);
  }

  .qrest-desktop-frame img {
    width: 100%;
    height: auto;
    display: block;
  }

  .detail-title {
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    font-weight: 800;
    color: #fff;
    margin-bottom: 1rem;
  }

  .detail-desc {
    font-size: 0.97rem;
    color: rgba(255,255,255,0.72);
    line-height: 1.7;
    margin-bottom: 0.8rem;
  }

  /* Features */
  .detail-features {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.6rem;
    margin: 1.2rem 0;
  }

  .df-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.88rem;
    color: rgba(255,255,255,0.82);
  }

  .df-item i {
    color: #00aaff;
    font-size: 0.95rem;
    flex-shrink: 0;
  }

  /* Offer block */
  .offer-block {
    background: linear-gradient(135deg, rgba(255,183,0,0.08), rgba(255,120,0,0.05));
    border: 1px solid rgba(255,183,0,0.25);
    border-radius: 14px;
    padding: 1.2rem 1.5rem;
    margin: 1.2rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .offer-label {
    font-size: 0.82rem;
    color: #ffb700;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .offer-price {
    font-size: 2.4rem;
    font-weight: 800;
    color: #fff;
    line-height: 1;
  }

  .offer-price span {
    font-size: 1rem;
    font-weight: 500;
    color: rgba(255,255,255,0.55);
  }

  .offer-includes {
    font-size: 0.88rem;
    color: rgba(255,255,255,0.75);
    display: flex;
    align-items: center;
    gap: 7px;
  }

  .offer-includes i {
    color: #25d366;
    font-size: 0.95rem;
  }

  /* Actions */
  .detail-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 1rem;
  }

  .btn-detail-primary {
    background: linear-gradient(135deg, #00aaff, #0077cc);
    color: white;
    padding: 12px 24px;
    border-radius: 10px;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: all 0.3s ease;
  }

  .btn-detail-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(0,170,255,0.4);
    color: white;
    text-decoration: none;
  }

  .btn-detail-whatsapp {
    background: linear-gradient(135deg, #25d366, #128c7e);
    color: white;
    padding: 12px 24px;
    border-radius: 10px;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: all 0.3s ease;
  }

  .btn-detail-whatsapp:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(37,211,102,0.4);
    color: white;
    text-decoration: none;
  }

  /* Visuals */
  .screenshot-frame {
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid rgba(0,170,255,0.2);
    box-shadow: 0 20px 50px rgba(0,0,0,0.4);
  }

  .detail-screenshot {
    width: 100%;
    display: block;
    object-fit: cover;
  }

  .screenshots-stack {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .stack-top, .stack-bottom {
    border-radius: 12px;
    border: 1px solid rgba(0,170,255,0.15);
    box-shadow: 0 10px 30px rgba(0,0,0,0.35);
  }

  /* Divider */
  .section-divider {
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(0,170,255,0.2), transparent);
    margin: 0 2rem;
  }

  /* Responsive */
  @media (max-width: 900px) {
    .product-detail-grid,
    .product-detail-grid.reverse {
      grid-template-columns: 1fr;
      direction: ltr;
    }

    .product-detail-grid.reverse > * {
      direction: ltr;
    }

    .detail-features {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 576px) {
    .detail-actions {
      flex-direction: column;
    }

    .qrest-visual-layout {
      flex-direction: column;
      gap: 1rem;
    }

    .qrest-mobile-frame {
      width: 100%;
      max-width: 280px;
      margin: 0 auto;
    }

    .qrest-desktop-frame {
      width: 100%;
    }
  }
</style>

</Layout>
