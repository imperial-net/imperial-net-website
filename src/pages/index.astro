---
import Layout from "../layouts/BaseLayout.astro";
import HeroSection from "../components/HeroSection.astro";
import SolutionsSection from "../components/SolutionsSection.astro";
import AboutSection from "../components/AboutSection.astro";
import CasesSection from "../components/CasesSection.astro";
import Testimonials from "../components/Testimonials.astro";
import BlogSection from "../components/BlogSection.astro";
import FAQ from "../components/FAQ.astro";
import ContactSection from "../components/ContactSection.astro";
import CTASection from "../components/CTASection.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Imperial Net | Software a Medida" description="Automatizamos procesos y potenciamos tu PyME">
    <HeroSection />
    <SolutionsSection />
    <AboutSection />
    <CasesSection />
    <Testimonials />
    <BlogSection />
    <FAQ />
    <ContactSection />
    <CTASection />
    <Footer />
    
    <!-- Voiceflow Chat Widget -->
    <script type="text/javascript">
      (function(d, t) {
          var v = d.createElement(t), s = d.getElementsByTagName(t)[0];
          v.onload = function() {
            window.voiceflow.chat.load({
              verify: { projectID: '68ecc366ab414dd88a87b3af' },
              url: 'https://general-runtime.voiceflow.com',
              versionID: 'production',
              voice: {
                url: "https://runtime-api.voiceflow.com"
              },
              render: {
                mode: 'embedded',
                target: document.getElementById('voiceflow-chat')
              }
            });
          }
          v.src = "https://cdn.voiceflow.com/widget-next/bundle.mjs"; 
          v.type = "text/javascript"; 
          s.parentNode.insertBefore(v, s);
      })(document, 'script');
    </script>
</Layout>
