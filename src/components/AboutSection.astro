---
import "../../public/css/about-section.css";
---

<section id="nosotros" class="about-section-modern">
  <!-- Background con efectos -->
  <div class="about-bg-modern">
    <div class="gradient-overlay-modern"></div>
    <div class="geometric-shapes-modern">
      <div class="shape-modern shape-1-modern"></div>
      <div class="shape-modern shape-2-modern"></div>
      <div class="shape-modern shape-3-modern"></div>
      <div class="shape-modern shape-4-modern"></div>
    </div>
  </div>

  <div class="container">
    
    <!-- Header de la sección -->
    <div class="about-header-modern text-center">
      <div class="section-badge-modern" data-aos="fade-down">
        <i class="bi bi-people"></i>
        <span>Conocenos</span>
      </div>
      
      <h2 class="section-title-modern" data-aos="fade-up" data-aos-delay="100">
        Sobre <span class="text-gradient-modern">Nosotros</span>
      </h2>
      
      <div class="intro-content-modern" data-aos="fade-up" data-aos-delay="200">
        <p class="section-subtitle-modern">
          En <span class="brand-highlight-modern">Imperial Net</span> acompañamos a las PyMEs en su transformación digital combinando 
          <strong>consultoría estratégica</strong>, <strong>desarrollo de software a medida</strong> e 
          <strong>implementación de soluciones tecnológicas</strong>.
        </p>
        
        <!-- Stats rápidos -->
        <div class="quick-stats-modern">
          <div class="stat-item-modern" data-aos="fade-up" data-aos-delay="300">
            <div class="stat-number-modern">50+</div>
            <div class="stat-label-modern">Proyectos Exitosos</div>
          </div>
          <div class="stat-item-modern" data-aos="fade-up" data-aos-delay="400">
            <div class="stat-number-modern">5+</div>
            <div class="stat-label-modern">Años de Experiencia</div>
          </div>
          <div class="stat-item-modern" data-aos="fade-up" data-aos-delay="500">
            <div class="stat-number-modern">100%</div>
            <div class="stat-label-modern">Satisfacción Cliente</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Grid de valores corporativos -->
    <div class="corporate-grid-modern">

      <!-- Misión -->
      <div class="corporate-card-modern mission-card-modern" data-aos="fade-up" data-aos-delay="200">
        <div class="card-background-modern"></div>
        <div class="card-content-modern">
          <div class="card-icon-modern">
            <i class="bi bi-bullseye"></i>
            <div class="icon-pulse-modern"></div>
          </div>
          <h3 class="card-title-modern">Nuestra Misión</h3>
          <p class="card-description-modern">
            Brindar soluciones digitales integrales que modernicen y optimicen los procesos operativos de las PyMEs, 
            mediante herramientas tecnológicas adaptadas a su realidad específica.
          </p>
          <div class="card-features-modern">
            <span class="feature-tag-modern">Innovación</span>
            <span class="feature-tag-modern">Personalización</span>
            <span class="feature-tag-modern">Resultados</span>
          </div>
        </div>
      </div>

      <!-- Visión -->
      <div class="corporate-card-modern vision-card-modern" data-aos="fade-up" data-aos-delay="400">
        <div class="card-background-modern"></div>
        <div class="card-content-modern">
          <div class="card-icon-modern">
            <i class="bi bi-eye"></i>
            <div class="icon-pulse-modern"></div>
          </div>
          <h3 class="card-title-modern">Nuestra Visión</h3>
          <p class="card-description-modern">
            Ser referentes en transformación digital para PyMEs en Trenque Lauquen y alrededores, 
            consolidándonos como aliados estratégicos de confianza en su crecimiento.
          </p>
          <div class="card-features-modern">
            <span class="feature-tag-modern">Liderazgo</span>
            <span class="feature-tag-modern">Confianza</span>
            <span class="feature-tag-modern">Crecimiento</span>
          </div>
        </div>
      </div>

      <!-- Valores -->
      <div class="corporate-card-modern values-card-modern" data-aos="fade-up" data-aos-delay="600">
        <div class="card-background-modern"></div>
        <div class="card-content-modern">
          <div class="card-icon-modern">
            <i class="bi bi-heart"></i>
            <div class="icon-pulse-modern"></div>
          </div>
          <h3 class="card-title-modern">Nuestros Valores</h3>
          <div class="values-list-modern">
            <div class="value-item-modern">
              <i class="bi bi-check-circle"></i>
              <span>Compromiso con los resultados</span>
            </div>
            <div class="value-item-modern">
              <i class="bi bi-check-circle"></i>
              <span>Transparencia y claridad</span>
            </div>
            <div class="value-item-modern">
              <i class="bi bi-check-circle"></i>
              <span>Innovación aplicada</span>
            </div>
            <div class="value-item-modern">
              <i class="bi bi-check-circle"></i>
              <span>Excelencia técnica y humana</span>
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- Sección de equipo/proceso -->
    <div class="process-section-modern" data-aos="fade-up" data-aos-delay="800">
      <div class="process-content-modern">
        <h3 class="process-title-modern">¿Cómo trabajamos?</h3>
        <p class="process-subtitle-modern">Nuestro enfoque metodológico para garantizar el éxito de tu proyecto</p>
        
        <div class="process-steps-modern">
          <div class="step-item-modern">
            <div class="step-number-modern">1</div>
            <div class="step-content-modern">
              <h4>Análisis</h4>
              <p>Estudiamos tu negocio y procesos actuales</p>
            </div>
          </div>
          <div class="step-item-modern">
            <div class="step-number-modern">2</div>
            <div class="step-content-modern">
              <h4>Diseño</h4>
              <p>Creamos la solución perfecta para ti</p>
            </div>
          </div>
          <div class="step-item-modern">
            <div class="step-number-modern">3</div>
            <div class="step-content-modern">
              <h4>Desarrollo</h4>
              <p>Construimos tu software con las mejores prácticas</p>
            </div>
          </div>
          <div class="step-item-modern">
            <div class="step-number-modern">4</div>
            <div class="step-content-modern">
              <h4>Implementación</h4>
              <p>Ponemos en marcha y capacitamos a tu equipo</p>
            </div>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>
