---
import BlogCard from "./BlogCard.astro";
import "../../public/css/blog-section.css";

// Posts estáticos del blog por ahora
const blogPosts = [
  {
    url: "/blog/gestion-inventario-pymes",
    frontmatter: {
      title: "Inventario sin caos: cómo evitar quiebres de stock y sobrestock en tu PyME",
      description: "Un mal manejo del inventario cuesta plata: productos vencidos, ventas perdidas, capital inmovilizado. Descubrí cómo digitalizarlo y ganar control real sobre tu stock.",
      date: "2026-01-14"
    }
  },
  {
    url: "/blog/atencion-cliente-digital-pymes",
    frontmatter: {
      title: "Atención al cliente digital: respondé más rápido y perdé menos ventas",
      description: "El cliente que no recibe respuesta rápida se va a la competencia. Descubrí cómo las PyMEs pueden mejorar su atención sin contratar más personal.",
      date: "2026-02-05"
    }
  },
  {
    url: "/blog/reportes-metricas-pymes",
    frontmatter: {
      title: "Datos que importan: cómo tomar mejores decisiones en tu PyME con reportes simples",
      description: "No necesitás ser analista de datos para usar información real en tu negocio. Descubrí qué métricas mirar y cómo un buen sistema te las muestra automáticamente.",
      date: "2026-03-18"
    }
  }
];
---

<section id="blog" class="py-5 text-white section-transition">
  <!-- Gradiente de transición superior -->
  <div class="gradient-fade-top"></div>
  
  <div class="container pt-5 pb-5">
    <div class="text-center mb-5" data-reveal>
      <h2 class="fw-bold mb-3">Nuestro Blog</h2>
      <p class="lead mb-4">
        Contenido valioso para hacer crecer tu negocio con tecnología
      </p>
    </div>
    
    <div class="row g-4 mb-5" data-reveal-stagger>
      {blogPosts.map((post, index) => (
        <div 
          class="col-md-6 col-lg-4"
        >
          <BlogCard post={post} />
        </div>
      ))}
    </div>

    <!-- CTA para ver más artículos -->
    <div class="text-center" data-reveal>
      <a 
        href="/blog" 
        class="btn btn-outline-light btn-lg px-4 py-2 rounded-pill hover-scale"
      >
        Ver todos los artículos
        <i class="bi bi-arrow-right ms-2"></i>
      </a>
    </div>
  </div>
  
  <!-- Gradiente de transición inferior -->
  <div class="gradient-fade-bottom"></div>
</section>

