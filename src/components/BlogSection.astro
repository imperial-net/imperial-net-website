---
import BlogCard from "./BlogCard.astro";

// Posts estáticos del blog por ahora
const blogPosts = [
  {
    url: "/blog/por-que-digitalizar-tu-empresa",
    frontmatter: {
      title: "👉 Por qué digitalizar tu empresa es una inversión rentable",
      description: "Descubrí cómo simplificar tareas y ahorrar dinero al llevar tus procesos a la pantalla.",
      date: "2025-08-02"
    }
  },
  {
    url: "/blog/automatizacion-para-pymes",
    frontmatter: {
      title: "👉 Automatización para PyMEs: cómo reducir costos y errores",
      description: "La automatización te ayuda a ahorrar tiempo, reducir errores y crecer sin complicaciones. Descubrí ejemplos simples que podés aplicar hoy en tu negocio.",
      date: "2025-08-01"
    }
  },
  {
    url: "/blog/como-elegir-un-software-a-medida",
    frontmatter: {
      title: "👉 Elegir software a medida: la clave para que tu negocio no se complique",
      description: "Conocé qué factores tenés que considerar al desarrollar o contratar un sistema hecho para tu negocio.",
      date: "2025-07-30"
    }
  }
];
---

<section id="blog" class="py-5 text-white section-transition">
  <!-- Gradiente de transición superior -->
  <div class="gradient-fade-top"></div>
  
  <div class="container pt-5 pb-5">
    <div class="text-center mb-5" data-aos="fade-up">
      <h2 class="fw-bold mb-3">📚 Nuestro Blog</h2>
      <p class="lead mb-4">
        Contenido valioso para hacer crecer tu negocio con tecnología
      </p>
    </div>
    
    <div class="row g-4 mb-5">
      {blogPosts.map((post, index) => (
        <div 
          class="col-md-6 col-lg-4" 
          data-aos="fade-up" 
          data-aos-delay={index * 150}
        >
          <BlogCard post={post} />
        </div>
      ))}
    </div>

    <!-- CTA para ver más artículos -->
    <div class="text-center" data-aos="fade-up" data-aos-delay="450">
      <a 
        href="/blog" 
        class="btn btn-outline-light btn-lg px-4 py-2 rounded-pill hover-scale"
      >
        Ver todos los artículos
        <i class="bi bi-arrow-right ms-2"></i>
      </a>
    </div>
  </div>
  
  <!-- Gradiente de transición inferior -->
  <div class="gradient-fade-bottom"></div>
</section>

<style>
  .hover-scale {
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  
  .hover-scale:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(255, 255, 255, 0.15);
  }
</style>
