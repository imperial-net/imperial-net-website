<section id="contacto" class="contact-section section-transition">
  <!-- Gradiente de transición superior -->
  <div class="gradient-fade-top"></div>
  
  <div class="container pb-5">
    <!-- Header de la sección -->
    <div class="contact-header text-center mb-5" data-aos="fade-up">
      <div class="contact-badge mb-3">
        <i class="bi bi-chat-heart"></i>
        <span>Hablemos</span>
      </div>
      <h2 class="contact-title mb-3">💬 ¿Listos para empezar?</h2>
      <p class="contact-subtitle">
        Contanos sobre tu proyecto y te ayudamos a hacerlo realidad
      </p>
    </div>

    <div class="row align-items-center">
      <!-- Información de contacto -->
      <div class="col-lg-5 mb-5 mb-lg-0" data-aos="fade-right">
        <div class="contact-info">
          <h3 class="contact-info-title mb-4">🚀 ¿Por qué elegirnos?</h3>
          
          <div class="contact-feature mb-4">
            <div class="feature-icon">
              <i class="bi bi-lightning-charge"></i>
            </div>
            <div class="feature-content">
              <h4>Desarrollo ágil</h4>
              <p>Entregas rápidas y resultados visibles desde el primer sprint</p>
            </div>
          </div>

          <div class="contact-feature mb-4">
            <div class="feature-icon">
              <i class="bi bi-shield-check"></i>
            </div>
            <div class="feature-content">
              <h4>Calidad garantizada</h4>
              <p>Código limpio, seguro y escalable para el futuro de tu negocio</p>
            </div>
          </div>

          <div class="contact-feature mb-4">
            <div class="feature-icon">
              <i class="bi bi-headset"></i>
            </div>
            <div class="feature-content">
              <h4>Soporte continuo</h4>
              <p>Te acompañamos antes, durante y después del desarrollo</p>
            </div>
          </div>

          <div class="contact-cta mt-4">
            <p class="mb-3"><strong>📞 ¿Preferís hablar directamente?</strong></p>
            <a href="https://wa.me/5492392556779" target="_blank" class="btn btn-whatsapp">
              <i class="bi bi-whatsapp"></i>
              Charlemos por WhatsApp
            </a>
          </div>
        </div>
      </div>

      <!-- Formulario de contacto -->
      <div class="col-lg-7" data-aos="fade-left">
        <div class="contact-form-wrapper">
          <form
            id="contact-form"
            action="https://email.mji.imperial-net.com/api/contact"
            method="POST"
            class="contact-form"
            novalidate
          >
            <div class="form-grid">
              <div class="form-group" data-aos="fade-up" data-aos-delay="200">
                <label for="name" class="form-label">
                  <i class="bi bi-person"></i>
                  Nombre completo
                </label>
                <input
                  type="text"
                  class="form-control"
                  id="name"
                  placeholder="¿Cómo te llamás?"
                />
              </div>

              <div class="form-group" data-aos="fade-up" data-aos-delay="300">
                <label for="email" class="form-label">
                  <i class="bi bi-envelope"></i>
                  Email
                </label>
                <input
                  type="email"
                  class="form-control"
                  id="email"
                  placeholder="tu@email.com"
                />
              </div>

              <div class="form-group" data-aos="fade-up" data-aos-delay="400">
                <label for="company" class="form-label">
                  <i class="bi bi-building"></i>
                  Empresa (opcional)
                </label>
                <input
                  type="text"
                  class="form-control"
                  id="company"
                  placeholder="Nombre de tu empresa"
                />
              </div>

              <div class="form-group" data-aos="fade-up" data-aos-delay="500">
                <label for="project-type" class="form-label">
                  <i class="bi bi-gear"></i>
                  Tipo de proyecto
                </label>
                <select class="form-control" id="project-type">
                  <option value="">Seleccioná una opción</option>
                  <option value="erp">Sistema ERP</option>
                  <option value="web-app">Aplicación Web</option>
                  <option value="ecommerce">E-commerce</option>
                  <option value="automation">Automatización de procesos</option>
                  <option value="integration">Integración de sistemas</option>
                  <option value="other">Otro proyecto</option>
                </select>
              </div>
            </div>

            <div class="form-group" data-aos="fade-up" data-aos-delay="600">
              <label for="message" class="form-label">
                <i class="bi bi-chat-text"></i>
                Contanos sobre tu proyecto
              </label>
              <textarea
                class="form-control"
                id="message"
                rows="5"
                placeholder="Describí brevemente qué necesitás, qué problemas querés resolver, o cualquier idea que tengas en mente..."></textarea>
            </div>

            <div class="form-submit" data-aos="fade-lef" data-aos-delay="700">
              <button type="submit" class="btn btn-primary btn-submit">
                <span class="btn-text">
                  <i class="bi bi-send"></i>
                  Enviar consulta
                </span>
                <span class="btn-loading">
                  <i class="bi bi-arrow-repeat spin"></i>
                  Enviando...
                </span>
              </button>
              <p class="form-note">
                📧 Te respondemos en menos de 24 horas
              </p>
            </div>

            <div id="form-message" class="form-message"></div>
          </form>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Gradiente de transición inferior -->
  <div class="gradient-fade-bottom"></div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const form = document.getElementById("contact-form") as HTMLFormElement;
    const formMessage = document.getElementById("form-message") as HTMLElement;
    const submitButton = form.querySelector("button[type='submit']") as HTMLButtonElement;
    const btnText = submitButton.querySelector('.btn-text') as HTMLElement;
    const btnLoading = submitButton.querySelector('.btn-loading') as HTMLElement;

    // Elementos del formulario
    const nameInput = document.getElementById("name") as HTMLInputElement;
    const emailInput = document.getElementById("email") as HTMLInputElement;
    const companyInput = document.getElementById("company") as HTMLInputElement;
    const projectTypeInput = document.getElementById("project-type") as HTMLSelectElement;
    const messageInput = document.getElementById("message") as HTMLTextAreaElement;

    // Funciones de validación
    function validateEmail(email: string): boolean {
      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      return emailRegex.test(email);
    }

    function validateName(name: string): boolean {
      return name.trim().length >= 2;
    }

    function validateMessage(message: string): boolean {
      return message.trim().length >= 10;
    }

    function validateProjectType(projectType: string): boolean {
      return projectType !== "";
    }

    // Función para mostrar error en campo específico
    function showFieldError(input: HTMLElement, message: string) {
      clearFieldError(input);
      
      const errorDiv = document.createElement('div');
      errorDiv.className = 'field-error';
      errorDiv.innerHTML = `<i class="bi bi-exclamation-circle"></i> ${message}`;
      
      input.parentNode?.appendChild(errorDiv);
      input.classList.add('error');
    }

    // Función para limpiar error de campo específico
    function clearFieldError(input: HTMLElement) {
      const existingError = input.parentNode?.querySelector('.field-error');
      if (existingError) {
        existingError.remove();
      }
      input.classList.remove('error');
    }

    // Función para limpiar todos los errores
    function clearAllErrors() {
      const allErrors = form.querySelectorAll('.field-error');
      allErrors.forEach(error => error.remove());
      
      const allInputs = form.querySelectorAll('.form-control');
      allInputs.forEach(input => input.classList.remove('error'));
    }

    // Función principal de validación
    function validateForm(): boolean {
      let isValid = true;
      clearAllErrors();

      // Validar nombre
      if (!validateName(nameInput.value)) {
        showFieldError(nameInput, 'El nombre debe tener al menos 2 caracteres');
        isValid = false;
      }

      // Validar email
      if (!emailInput.value.trim()) {
        showFieldError(emailInput, 'El email es obligatorio');
        isValid = false;
      } else if (!validateEmail(emailInput.value)) {
        showFieldError(emailInput, 'Ingresá un email válido (ejemplo@correo.com)');
        isValid = false;
      }

      // Validar tipo de proyecto
      if (!validateProjectType(projectTypeInput.value)) {
        showFieldError(projectTypeInput, 'Seleccioná el tipo de proyecto');
        isValid = false;
      }

      // Validar mensaje
      if (!validateMessage(messageInput.value)) {
        showFieldError(messageInput, 'El mensaje debe tener al menos 10 caracteres');
        isValid = false;
      }

      return isValid;
    }

    // Validación en tiempo real
    nameInput.addEventListener('blur', () => {
      if (nameInput.value.trim()) {
        if (validateName(nameInput.value)) {
          clearFieldError(nameInput);
        } else {
          showFieldError(nameInput, 'El nombre debe tener al menos 2 caracteres');
        }
      }
    });

    emailInput.addEventListener('blur', () => {
      if (emailInput.value.trim()) {
        if (validateEmail(emailInput.value)) {
          clearFieldError(emailInput);
        } else {
          showFieldError(emailInput, 'Ingresá un email válido (ejemplo@correo.com)');
        }
      }
    });

    messageInput.addEventListener('blur', () => {
      if (messageInput.value.trim()) {
        if (validateMessage(messageInput.value)) {
          clearFieldError(messageInput);
        } else {
          showFieldError(messageInput, 'El mensaje debe tener al menos 10 caracteres');
        }
      }
    });

    projectTypeInput.addEventListener('change', () => {
      if (validateProjectType(projectTypeInput.value)) {
        clearFieldError(projectTypeInput);
      } else {
        showFieldError(projectTypeInput, 'Seleccioná el tipo de proyecto');
      }
    });

    // También validar cuando se hace blur en el select
    projectTypeInput.addEventListener('blur', () => {
      if (!validateProjectType(projectTypeInput.value)) {
        showFieldError(projectTypeInput, 'Seleccioná el tipo de proyecto');
      }
    });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      // Usar nuestras validaciones personalizadas
      if (!validateForm()) {
        // Hacer scroll al primer error
        const firstError = form.querySelector('.error');
        if (firstError) {
          firstError.scrollIntoView({ behavior: 'smooth', block: 'center' });
          (firstError as HTMLElement).focus();
        }
        return;
      }

      // Cambiar estado del botón a cargando
      submitButton.disabled = true;
      btnText.style.display = 'none';
      btnLoading.style.display = 'flex';
      
      // Limpiar mensaje anterior
      formMessage.className = "";
      formMessage.textContent = "";

      // Crear mensaje completo con todos los datos
      let fullMessage = messageInput.value.trim();
      
      // Agregar información adicional al mensaje
      fullMessage += '\n\n--- Información adicional ---';
      
      if (companyInput.value.trim()) {
        fullMessage += `\nEmpresa: ${companyInput.value}`;
      }
      
      if (projectTypeInput.value) {
        const projectTypeText = projectTypeInput.options[projectTypeInput.selectedIndex].text;
        fullMessage += `\nTipo de proyecto: ${projectTypeText}`;
      }

      const data = {
        name: nameInput.value.trim(),
        email: emailInput.value,
        message: fullMessage
      };

      try {
        const response = await fetch(form.action, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            "Accept": "application/json"
          },
          body: JSON.stringify(data),
        });

        if (response.ok) {
          formMessage.className = "form-message success";
          formMessage.innerHTML = `
            <div class="message-icon">
              <i class="bi bi-check-circle"></i>
            </div>
            <div class="message-content">
              <h4>¡Mensaje enviado! 🎉</h4>
              <p>Gracias por contactarnos. Te responderemos en menos de 24 horas.</p>
            </div>
          `;
          form.reset();
        } else {
          throw new Error('Error en el servidor');
        }
      } catch (err) {
        formMessage.className = "form-message error";
        formMessage.innerHTML = `
          <div class="message-icon">
            <i class="bi bi-exclamation-triangle"></i>
          </div>
          <div class="message-content">
            <h4>Error al enviar</h4>
            <p>Hubo un problema al enviar tu mensaje. Por favor, intentá de nuevo o contactanos por WhatsApp.</p>
          </div>
        `;
      } finally {
        // Restaurar el botón
        submitButton.disabled = false;
        btnText.style.display = 'flex';
        btnLoading.style.display = 'none';
      }
    });
  });
</script>

