---
import "../../public/css/hero-section.css";
---

<section id="hero" class="hero-section d-flex align-items-center justify-content-center text-white">
  <!-- Video de fondo -->
  <video autoplay muted loop playsinline class="bg-video" aria-label="Video de fondo mostrando tecnología y digitalización">
    <source src="/videos/hero (2).mp4" type="video/mp4" />
    Tu navegador no soporta videos HTML5.
  </video>

  <!-- Overlay gradient -->
  <div class="hero-overlay"></div>

  <!-- Contenido principal -->
  <div class="container hero-content">
    <div class="row justify-content-center">
      <div class="col-lg-10 col-xl-8 text-center">
        
        <!-- Badge superior -->
        <div class="hero-badge" data-aos="fade-down" data-aos-delay="100">
          <i class="bi bi-lightning-charge"></i>
          <span>Transformación Digital</span>
        </div>

        <!-- Título principal -->
        <h1 class="hero-title" data-aos="fade-up" data-aos-delay="200">
          Digitalizá tu empresa.<br>
          <span class="text-gradient">Crecé sin límites.</span>
        </h1>

        <!-- Subtítulo -->
        <p class="hero-subtitle" data-aos="fade-up" data-aos-delay="400">
          Automatizamos procesos, optimizamos tu tiempo y llevamos tu negocio al siguiente nivel con 
          <span class="highlight">software personalizado</span> que se adapta a tus necesidades.
        </p>

        <!-- Botones de acción -->
        <div class="hero-actions" data-aos="fade-up" data-aos-delay="600">
          <a href="#contacto" class="btn-primary-hero">
            <i class="bi bi-rocket-takeoff"></i>
            Quiero digitalizar mi negocio
          </a>
          <a href="#soluciones" class="btn-secondary-hero">
            <i class="bi bi-play-circle"></i>
            Ver soluciones
          </a>
        </div>

        <!-- Indicadores de confianza -->
        <div class="hero-trust" data-aos="fade-up" data-aos-delay="800">
          <div class="trust-item">
            <i class="bi bi-shield-check"></i>
            <span>100% Seguro</span>
          </div>
          <div class="trust-item">
            <i class="bi bi-clock"></i>
            <span>Entrega garantizada</span>
          </div>
          <div class="trust-item">
            <i class="bi bi-headset"></i>
            <span>Soporte 24/7</span>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- Elementos decorativos -->
  <div class="hero-decorations">
    <div class="floating-element element-1"></div>
    <div class="floating-element element-2"></div>
    <div class="floating-element element-3"></div>
  </div>

  <!-- Scroll indicator -->
  <div class="scroll-indicator" data-aos="fade-in" data-aos-delay="1000">
    <span>Descubrí más</span>
    <i class="bi bi-chevron-down"></i>
  </div>
</section>

<script>
  // Funcionalidad del scroll indicator
  document.addEventListener('DOMContentLoaded', function() {
    const scrollIndicator = document.querySelector('.scroll-indicator');
    
    if (scrollIndicator) {
      scrollIndicator.addEventListener('click', function() {
        const nextSection = document.querySelector('#soluciones') || document.querySelector('section:nth-of-type(2)');
        if (nextSection) {
          const navbar = document.querySelector('.navbar');
          const navbarHeight = navbar ? (navbar as HTMLElement).offsetHeight : 80;
          const targetPosition = (nextSection as HTMLElement).offsetTop - navbarHeight;
          
          window.scrollTo({
            top: targetPosition,
            behavior: 'smooth'
          });
        }
      });
    }
    
    // Ocultar scroll indicator al hacer scroll
    let scrolled = false;
    window.addEventListener('scroll', function() {
      const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
      
      if (scrollTop > 100 && !scrolled && scrollIndicator) {
        (scrollIndicator as HTMLElement).style.opacity = '0';
        (scrollIndicator as HTMLElement).style.transform = 'translateX(-50%) translateY(20px)';
        scrolled = true;
      } else if (scrollTop <= 100 && scrolled && scrollIndicator) {
        (scrollIndicator as HTMLElement).style.opacity = '1';
        (scrollIndicator as HTMLElement).style.transform = 'translateX(-50%) translateY(0)';
        scrolled = false;
      }
    }, { passive: true });
  });
</script>
