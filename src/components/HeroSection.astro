---
import "../styles/hero-section.css";
---

<section id="hero" class="hero-section d-flex align-items-center justify-content-center text-white">
  <!-- Fondo estático -->
  <div class="hero-backdrop" aria-hidden="true"></div>

  <!-- Overlay gradient -->
  <div class="hero-overlay"></div>

  <!-- Contenido principal -->
  <div class="container hero-content">
    <div class="row justify-content-center">
      <div class="col-lg-10 col-xl-8 text-center" data-reveal-stagger>
        
        <!-- Título principal -->
        <h1 class="hero-title">
          Digitalizá tu negocio.<br>
          <span class="text-gradient">Crecé sin límites.</span>
        </h1>

        <!-- Subtítulo -->
        <p class="hero-subtitle">
          Automatizamos procesos, optimizamos tu tiempo y llevamos tu negocio al siguiente nivel con
          <span class="highlight">software personalizado</span> para PyMEs de Trenque Lauquen y la región.
        </p>

        <!-- Botones de acción -->
        <div class="hero-actions">
          <a href="#contacto" class="btn-primary-hero">
            <i class="bi bi-rocket-takeoff"></i>
            Quiero digitalizar mi negocio
          </a>
          <a href="#soluciones" class="btn-secondary-hero">
            <i class="bi bi-play-circle"></i>
            Ver soluciones
          </a>
        </div>

      </div>
    </div>
  </div>

  <!-- Elementos decorativos -->
  <div class="hero-decorations">
    <div class="floating-element element-1"></div>
    <div class="floating-element element-2"></div>
    <div class="floating-element element-3"></div>
  </div>

  <!-- Scroll indicator -->
  <div class="scroll-indicator" data-reveal>
    <span>Descubrí más</span>
    <i class="bi bi-chevron-down"></i>
  </div>
</section>

<script>
  // Funcionalidad del scroll indicator
  document.addEventListener('DOMContentLoaded', function() {
    const scrollIndicator = document.querySelector('.scroll-indicator');
    
    if (scrollIndicator) {
      scrollIndicator.addEventListener('click', function() {
        const nextSection = document.querySelector('#soluciones') || document.querySelector('section:nth-of-type(2)');
        if (nextSection) {
          const navbar = document.querySelector('.navbar');
          const navbarHeight = navbar ? (navbar as HTMLElement).offsetHeight : 80;
          const targetPosition = (nextSection as HTMLElement).offsetTop - navbarHeight;
          
          window.scrollTo({
            top: targetPosition,
            behavior: 'smooth'
          });
        }
      });
    }
    
    // Ocultar scroll indicator al hacer scroll (throttled con rAF)
    let scrolled = false;
    let indicatorTicking = false;
    const indicator = scrollIndicator as HTMLElement | null;
    window.addEventListener('scroll', function() {
      if (!indicatorTicking) {
        requestAnimationFrame(function() {
          const scrollTop = window.scrollY;
          if (scrollTop > 100 && !scrolled && indicator) {
            indicator.style.opacity = '0';
            indicator.style.transform = 'translateX(-50%) translateY(20px)';
            scrolled = true;
          } else if (scrollTop <= 100 && scrolled && indicator) {
            indicator.style.opacity = '1';
            indicator.style.transform = 'translateX(-50%) translateY(0)';
            scrolled = false;
          }
          indicatorTicking = false;
        });
        indicatorTicking = true;
      }
    }, { passive: true });
  });
</script>
