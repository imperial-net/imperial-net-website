---
import "../../public/css/cases-section.css";
---

<section id="casos" class="cases-section-modern">
  <!-- Background con efectos -->
  <div class="cases-bg-modern">
    <div class="gradient-overlay-cases"></div>
    <div class="floating-elements-cases">
      <div class="element-cases element-1-cases"></div>
      <div class="element-cases element-2-cases"></div>
      <div class="element-cases element-3-cases"></div>
    </div>
  </div>

  <div class="container">
    
    <!-- Header de la sección -->
    <div class="cases-header-modern text-center" data-reveal-stagger>
      <div class="section-badge-cases">
        <i class="bi bi-trophy"></i>
        <span>Proyectos Destacados</span>
      </div>
      
      <h2 class="section-title-cases">
        Casos de <span class="text-gradient-cases">Éxito</span>
      </h2>
      
      <p class="section-subtitle-cases">
        Conocé algunos de nuestros proyectos más destacados y cómo hemos transformado negocios reales
      </p>
    </div>

    <!-- Grid de casos -->
    <div class="cases-grid-modern" data-reveal-stagger>

      <!-- El Ceibo -->
      <div class="case-card-modern">
        <div class="card-inner-cases">
          <div class="card-header-cases">
            <div class="logo-container-cases">
              <img src="/img/logos/el-ceibo.webp" alt="Logo El Ceibo - Club Deportivo - Cliente de Imperial Net" class="case-logo" loading="lazy">
              <div class="logo-glow"></div>
            </div>
            <div class="case-category">Club Deportivo</div>
          </div>
          
          <div class="card-content-cases">
            <h3 class="case-title">El Ceibo</h3>
            <p class="case-description">
              Sistema integral de gestión de socios y jugadores, control de pagos y cuotas que 
              modernizó completamente la administración del club.
            </p>
            
            <div class="case-features">
              <div class="feature-item">
                <i class="bi bi-people"></i>
                <span>Gestión de Socios</span>
              </div>
              <div class="feature-item">
                <i class="bi bi-credit-card"></i>
                <span>Control de Pagos</span>
              </div>
              <div class="feature-item">
                <i class="bi bi-graph-up"></i>
                <span>Reportes Avanzados</span>
              </div>
            </div>
            
            <div class="case-results">
              <div class="result-item">
                <span class="result-number">80%</span>
                <span class="result-label">Tiempo Ahorrado</span>
              </div>
              <div class="result-item">
                <span class="result-number">100%</span>
                <span class="result-label">Digital</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Coblan -->
      <div class="case-card-modern">
        <div class="card-inner-cases">
          <div class="card-header-cases">
            <div class="logo-container-cases">
              <img src="/img/logos/coblan.webp" alt="Logo Coblan - Servicios Empresariales - Cliente de Imperial Net" class="case-logo" loading="lazy">
              <div class="logo-glow"></div>
            </div>
            <div class="case-category">Servicios</div>
          </div>
          
          <div class="card-content-cases">
            <h3 class="case-title">Coblan</h3>
            <p class="case-description">
              Plataforma administrativa modular centralizada para gestión de servicios, 
              clientes, pagos y reportes contables integrados.
            </p>
            
            <div class="case-features">
              <div class="feature-item">
                <i class="bi bi-diagram-3"></i>
                <span>Sistema Modular</span>
              </div>
              <div class="feature-item">
                <i class="bi bi-calculator"></i>
                <span>Reportes Contables</span>
              </div>
              <div class="feature-item">
                <i class="bi bi-shield-check"></i>
                <span>Seguridad Avanzada</span>
              </div>
            </div>
            
            <div class="case-results">
              <div class="result-item">
                <span class="result-number">90%</span>
                <span class="result-label">Eficiencia</span>
              </div>
              <div class="result-item">
                <span class="result-number">5</span>
                <span class="result-label">Módulos</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Sol Fotofashion -->
      <div class="case-card-modern">
        <div class="card-inner-cases">
          <div class="card-header-cases">
            <div class="logo-container-cases">
              <img src="/img/logos/sol-fotofashion.webp" alt="Logo Sol Fotofashion - Estudio Fotográfico - Cliente de Imperial Net" class="case-logo" loading="lazy">
              <div class="logo-glow"></div>
            </div>
            <div class="case-category">Fotografía</div>
          </div>
          
          <div class="card-content-cases">
            <h3 class="case-title">Sol Fotofashion</h3>
            <p class="case-description">
              Sitio web institucional para estudio fotográfico, 
              optimizado para experiencia visual y mobile.
            </p>
            
            <div class="case-features">
              <div class="feature-item">
                <i class="bi bi-camera"></i>
                <span>Portfolio Visual</span>
              </div>
              <div class="feature-item">
                <i class="bi bi-images"></i>
                <span>Galería Optimizada</span>
              </div>
              <div class="feature-item">
                <i class="bi bi-phone"></i>
                <span>Mobile First</span>
              </div>
            </div>
            
            <div class="case-results">
              <div class="result-item">
                <span class="result-number">100%</span>
                <span class="result-label">Más Visitas</span>
              </div>
              <div class="result-item">
                <span class="result-number">95%</span>
                <span class="result-label">Mobile Score</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Tienda en Sueños -->
      <div class="case-card-modern">
        <div class="card-inner-cases">
          <div class="card-header-cases">
            <div class="logo-container-cases">
              <img src="/img/webp/tienda-en-suenios.webp" alt="Tienda en Sueños" class="case-logo" loading="lazy">
              <div class="logo-glow"></div>
            </div>
            <div class="case-category">Indumentaria</div>
          </div>

          <div class="card-content-cases">
            <h3 class="case-title">Tienda en Sueños</h3>
            <p class="case-description">
              Sistema de gestión para tienda de ropa: control de stock, inventario
              y administración completa del negocio.
            </p>
            
            <div class="case-features">
              <div class="feature-item">
                <i class="bi bi-boxes"></i>
                <span>Control de Stock</span>
              </div>
              <div class="feature-item">
                <i class="bi bi-clipboard-data"></i>
                <span>Gestión Inventario</span>
              </div>
              <div class="feature-item">
                <i class="bi bi-graph-up"></i>
                <span>Reportes Avanzados</span>
              </div>
            </div>
            
            <div class="case-results">
              <div class="result-item">
                <span class="result-number">100%</span>
                <span class="result-label">Control Stock</span>
              </div>
              <div class="result-item">
                <span class="result-number">80%</span>
                <span class="result-label">Tiempo Ahorrado</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Super Hijitus -->
      <div class="case-card-modern">
        <div class="card-inner-cases">
          <div class="card-header-cases">
            <div class="logo-container-cases">
              <img src="/img/logos/super-hijitus.webp" alt="Logo Super Hijitus - Supermercado - Cliente de Imperial Net" class="case-logo" loading="lazy">
              <div class="logo-glow"></div>
            </div>
            <div class="case-category">Supermercado</div>
          </div>

          <div class="card-content-cases">
            <h3 class="case-title">Super Hijitus</h3>
            <p class="case-description">
              Supermercado que gestiona su stock y sus ventas con Inventory Desktop:
              control de inventario en tiempo real, facturación y escáner de código de barras.
            </p>

            <div class="case-features">
              <div class="feature-item">
                <i class="bi bi-upc-scan"></i>
                <span>Escáner de Códigos</span>
              </div>
              <div class="feature-item">
                <i class="bi bi-boxes"></i>
                <span>Control de Stock</span>
              </div>
              <div class="feature-item">
                <i class="bi bi-receipt"></i>
                <span>Registro de Ventas</span>
              </div>
            </div>

            <div class="case-results">
              <div class="result-item">
                <span class="result-number">100%</span>
                <span class="result-label">Stock Digital</span>
              </div>
              <div class="result-item">
                <span class="result-number">0</span>
                <span class="result-label">Cuota Mensual</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- QRest -->
      <div class="case-card-modern">
        <div class="card-inner-cases">
          <div class="card-header-cases">
            <div class="logo-container-cases">
              <img src="/img/webp/logo.webp" alt="Logo QRest - Sistema administrativo para restaurantes y bares - Producto de Imperial Net" class="case-logo" loading="lazy">
              <div class="logo-glow"></div>
            </div>
            <div class="case-category">Gastronomía</div>
          </div>

          <div class="card-content-cases">
            <h3 class="case-title">QRest</h3>
            <p class="case-description">
              Sistema administrativo para restaurantes y bares: gestión de mesas, pedidos,
              cuentas y reportes de ingresos, con carta digital integrada.
            </p>

            <div class="case-features">
              <div class="feature-item">
                <i class="bi bi-grid-3x3-gap"></i>
                <span>Gestión de Mesas</span>
              </div>
              <div class="feature-item">
                <i class="bi bi-receipt-cutoff"></i>
                <span>Pedidos y Cuentas</span>
              </div>
              <div class="feature-item">
                <i class="bi bi-graph-up-arrow"></i>
                <span>Reportes de Ingresos</span>
              </div>
            </div>

            <div class="case-results">
              <div class="result-item">
                <span class="result-number">100%</span>
                <span class="result-label">Salón Digital</span>
              </div>
              <div class="result-item">
                <span class="result-number">Web</span>
                <span class="result-label">Desde Cualquier Lugar</span>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- CTA Final -->
    <div class="cases-cta-modern text-center" data-reveal>
      <h3 class="cta-title-cases">¿Listo para ser nuestro próximo caso de éxito?</h3>
      <p class="cta-subtitle-cases">Contanos tu proyecto y empecemos a trabajar juntos</p>
      <a href="#contacto" class="btn-cases-cta">
        <i class="bi bi-rocket-takeoff"></i>
        Empezar mi proyecto
      </a>
    </div>

  </div>
</section>
