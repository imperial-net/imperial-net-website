---
import "../../public/css/cases-section.css";
---

<section id="casos" class="cases-section-modern">
  <!-- Background con efectos -->
  <div class="cases-bg-modern">
    <div class="gradient-overlay-cases"></div>
    <div class="floating-elements-cases">
      <div class="element-cases element-1-cases"></div>
      <div class="element-cases element-2-cases"></div>
      <div class="element-cases element-3-cases"></div>
    </div>
  </div>

  <div class="container">
    
    <!-- Header de la sección -->
    <div class="cases-header-modern text-center">
      <div class="section-badge-cases" data-aos="fade-down">
        <i class="bi bi-trophy"></i>
        <span>Proyectos Destacados</span>
      </div>
      
      <h2 class="section-title-cases" data-aos="fade-up" data-aos-delay="100">
        Casos de <span class="text-gradient-cases">Éxito</span>
      </h2>
      
      <p class="section-subtitle-cases" data-aos="fade-up" data-aos-delay="200">
        Conocé algunos de nuestros proyectos más destacados y cómo hemos transformado negocios reales
      </p>
    </div>

    <!-- Grid de casos -->
    <div class="cases-grid-modern">

      <!-- El Ceibo -->
      <div class="case-card-modern" data-aos="fade-up" data-aos-delay="100">
        <div class="card-inner-cases">
          <div class="card-header-cases">
            <div class="logo-container-cases">
              <img src="/img/logos/el-ceibo.webp" alt="Logo El Ceibo - Club Deportivo - Cliente de Imperial Net" class="case-logo">
              <div class="logo-glow"></div>
            </div>
            <div class="case-category">Club Deportivo</div>
          </div>
          
          <div class="card-content-cases">
            <h3 class="case-title">El Ceibo</h3>
            <p class="case-description">
              Sistema integral de gestión de socios y jugadores, control de pagos y cuotas que 
              modernizó completamente la administración del club.
            </p>
            
            <div class="case-features">
              <div class="feature-item">
                <i class="bi bi-people"></i>
                <span>Gestión de Socios</span>
              </div>
              <div class="feature-item">
                <i class="bi bi-credit-card"></i>
                <span>Control de Pagos</span>
              </div>
              <div class="feature-item">
                <i class="bi bi-graph-up"></i>
                <span>Reportes Avanzados</span>
              </div>
            </div>
            
            <div class="case-results">
              <div class="result-item">
                <span class="result-number">80%</span>
                <span class="result-label">Tiempo Ahorrado</span>
              </div>
              <div class="result-item">
                <span class="result-number">100%</span>
                <span class="result-label">Digital</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Coblan -->
      <div class="case-card-modern" data-aos="fade-up" data-aos-delay="200">
        <div class="card-inner-cases">
          <div class="card-header-cases">
            <div class="logo-container-cases">
              <img src="/img/logos/coblan.webp" alt="Logo Coblan - Servicios Empresariales - Cliente de Imperial Net" class="case-logo">
              <div class="logo-glow"></div>
            </div>
            <div class="case-category">Servicios</div>
          </div>
          
          <div class="card-content-cases">
            <h3 class="case-title">Coblan</h3>
            <p class="case-description">
              Plataforma administrativa modular centralizada para gestión de servicios, 
              clientes, pagos y reportes contables integrados.
            </p>
            
            <div class="case-features">
              <div class="feature-item">
                <i class="bi bi-diagram-3"></i>
                <span>Sistema Modular</span>
              </div>
              <div class="feature-item">
                <i class="bi bi-calculator"></i>
                <span>Reportes Contables</span>
              </div>
              <div class="feature-item">
                <i class="bi bi-shield-check"></i>
                <span>Seguridad Avanzada</span>
              </div>
            </div>
            
            <div class="case-results">
              <div class="result-item">
                <span class="result-number">90%</span>
                <span class="result-label">Eficiencia</span>
              </div>
              <div class="result-item">
                <span class="result-number">5</span>
                <span class="result-label">Módulos</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Sol Fotofashion -->
      <div class="case-card-modern" data-aos="fade-up" data-aos-delay="300">
        <div class="card-inner-cases">
          <div class="card-header-cases">
            <div class="logo-container-cases">
              <img src="/img/logos/sol-fotofashion.webp" alt="Logo Sol Fotofashion - Estudio Fotográfico - Cliente de Imperial Net" class="case-logo">
              <div class="logo-glow"></div>
            </div>
            <div class="case-category">Fotografía</div>
          </div>
          
          <div class="card-content-cases">
            <h3 class="case-title">Sol Fotofashion</h3>
            <p class="case-description">
              Sitio web institucional para estudio fotográfico, 
              optimizado para experiencia visual y mobile.
            </p>
            
            <div class="case-features">
              <div class="feature-item">
                <i class="bi bi-camera"></i>
                <span>Portfolio Visual</span>
              </div>
              <div class="feature-item">
                <i class="bi bi-images"></i>
                <span>Galería Optimizada</span>
              </div>
              <div class="feature-item">
                <i class="bi bi-phone"></i>
                <span>Mobile First</span>
              </div>
            </div>
            
            <div class="case-results">
              <div class="result-item">
                <span class="result-number">100%</span>
                <span class="result-label">Más Visitas</span>
              </div>
              <div class="result-item">
                <span class="result-number">95%</span>
                <span class="result-label">Mobile Score</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Tienda en Sueños -->
      <div class="case-card-modern" data-aos="fade-up" data-aos-delay="400">
        <div class="card-inner-cases">
          <div class="card-header-cases">
            <div class="logo-container-cases">
              <img src="/img/logos/tienda-en-suenios.jpg" alt="Tienda en Sueños" class="case-logo">
              <div class="logo-glow"></div>
            </div>
            <div class="case-category">ERP</div>
          </div>
          
          <div class="card-content-cases">
            <h3 class="case-title">Tienda en Sueños</h3>
            <p class="case-description">
              Sistema ERP integral para control de stock, gestión de inventario 
              y administración completa de la tienda de ropa.
            </p>
            
            <div class="case-features">
              <div class="feature-item">
                <i class="bi bi-boxes"></i>
                <span>Control de Stock</span>
              </div>
              <div class="feature-item">
                <i class="bi bi-clipboard-data"></i>
                <span>Gestión Inventario</span>
              </div>
              <div class="feature-item">
                <i class="bi bi-graph-up"></i>
                <span>Reportes Avanzados</span>
              </div>
            </div>
            
            <div class="case-results">
              <div class="result-item">
                <span class="result-number">100%</span>
                <span class="result-label">Control Stock</span>
              </div>
              <div class="result-item">
                <span class="result-number">80%</span>
                <span class="result-label">Tiempo Ahorrado</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Mi Chofer -->
      <div class="case-card-modern" data-aos="fade-up" data-aos-delay="500">
        <div class="card-inner-cases">
          <div class="card-header-cases">
            <div class="logo-container-cases">
              <img src="/img/logos/mi-chofer.webp" alt="Logo Mi Chofer - Marketing Digital - Cliente de Imperial Net" class="case-logo">
              <div class="logo-glow"></div>
            </div>
            <div class="case-category">Marketing</div>
          </div>
          
          <div class="card-content-cases">
            <h3 class="case-title">Mi Chofer</h3>
            <p class="case-description">
              Sitio web publicitario para empresa de transporte ejecutivo, 
              diseño atractivo y optimizado para generar contactos comerciales.
            </p>
            
            <div class="case-features">
              <div class="feature-item">
                <i class="bi bi-palette"></i>
                <span>Diseño Atractivo</span>
              </div>
              <div class="feature-item">
                <i class="bi bi-telephone"></i>
                <span>Contacto Directo</span>
              </div>
              <div class="feature-item">
                <i class="bi bi-star"></i>
                <span>Servicios Premium</span>
              </div>
            </div>
            
            <div class="case-results">
              <div class="result-item">
                <span class="result-number">200%</span>
                <span class="result-label">Más Contactos</span>
              </div>
              <div class="result-item">
                <span class="result-number">Pro</span>
                <span class="result-label">Imagen</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- VisualReport -->
      <div class="case-card-modern" data-aos="fade-up" data-aos-delay="600">
        <div class="card-inner-cases">
          <div class="card-header-cases">
            <div class="logo-container-cases">
              <img src="/img/logos/visualreport.webp" alt="Logo VisualReport - IA y Tecnología - Cliente de Imperial Net" class="case-logo">
              <div class="logo-glow"></div>
            </div>
            <div class="case-category">IA & Tech</div>
          </div>
          
          <div class="card-content-cases">
            <h3 class="case-title">VisualReport</h3>
            <p class="case-description">
              Herramienta innovadora para generación automática de informes policiales 
              a partir de imágenes, integrando IA y procesamiento avanzado.
            </p>
            
            <div class="case-features">
              <div class="feature-item">
                <i class="bi bi-robot"></i>
                <span>Inteligencia Artificial</span>
              </div>
              <div class="feature-item">
                <i class="bi bi-image"></i>
                <span>Análisis de Imágenes</span>
              </div>
              <div class="feature-item">
                <i class="bi bi-file-earmark-text"></i>
                <span>Reportes Auto</span>
              </div>
            </div>
            
            <div class="case-results">
              <div class="result-item">
                <span class="result-number">95%</span>
                <span class="result-label">Precisión IA</span>
              </div>
              <div class="result-item">
                <span class="result-number">10x</span>
                <span class="result-label">Más Rápido</span>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- CTA Final -->
    <div class="cases-cta-modern text-center" data-aos="fade-up" data-aos-delay="700">
      <h3 class="cta-title-cases">¿Listo para ser nuestro próximo caso de éxito?</h3>
      <p class="cta-subtitle-cases">Contanos tu proyecto y empecemos a trabajar juntos</p>
      <a href="#contacto" class="btn-cases-cta">
        <i class="bi bi-rocket-takeoff"></i>
        Empezar mi proyecto
      </a>
    </div>

  </div>
</section>
