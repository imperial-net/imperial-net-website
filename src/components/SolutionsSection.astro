---
import "../../public/css/solutions-section.css";
---

<section id="soluciones" class="solutions-section section-transition">
  <!-- Gradiente de transición superior -->
  <div class="gradient-fade-top"></div>
  
  <!-- Background decorativo -->
  <div class="solutions-bg">
    <div class="bg-pattern"></div>
    <div class="floating-shapes">
      <div class="shape shape-1"></div>
      <div class="shape shape-2"></div>
      <div class="shape shape-3"></div>
    </div>
  </div>

  <div class="container">
    <!-- Header de la sección -->
    <div class="solutions-header text-center" data-reveal-stagger>
      <div class="section-badge">
        <i class="bi bi-lightning-charge"></i>
        <span>Nuestras Especialidades</span>
      </div>
      
      <h2 class="section-title">
        Soluciones Digitales 
        <span class="text-gradient">a Medida</span>
      </h2>
      
      <p class="section-subtitle">
        Transformamos ideas en soluciones tecnológicas que impulsan el crecimiento de tu negocio
      </p>
    </div>

    <!-- Grid de soluciones -->
    <div class="solutions-grid" data-reveal-stagger>

      <!-- Desarrollo Web -->
      <div class="solution-card">
        <div class="card-inner">
          <div class="card-icon">
            <i class="bi bi-globe2"></i>
            <div class="icon-bg"></div>
          </div>
          <div class="card-content">
            <h3 class="card-title">Desarrollo Web</h3>
            <p class="card-description">
              Sitios y sistemas web optimizados, responsivos y personalizados para potenciar tu presencia online.
            </p>
            <ul class="card-features">
              <li><i class="bi bi-check-circle"></i> Responsive Design</li>
              <li><i class="bi bi-check-circle"></i> SEO Optimizado</li>
              <li><i class="bi bi-check-circle"></i> Alta Performance</li>
            </ul>
          </div>
          <div class="card-hover-effect"></div>
        </div>
      </div>

      <!-- Automatización de Procesos -->
      <div class="solution-card">
        <div class="card-inner">
          <div class="card-icon">
            <i class="bi bi-gear-wide-connected"></i>
            <div class="icon-bg"></div>
          </div>
          <div class="card-content">
            <h3 class="card-title">Automatización de Procesos</h3>
            <p class="card-description">
              Transformamos procesos manuales en flujos automáticos, mejorando productividad y reduciendo errores.
            </p>
            <ul class="card-features">
              <li><i class="bi bi-check-circle"></i> Flujos Inteligentes</li>
              <li><i class="bi bi-check-circle"></i> Integración API</li>
              <li><i class="bi bi-check-circle"></i> Monitoreo 24/7</li>
            </ul>
          </div>
          <div class="card-hover-effect"></div>
        </div>
      </div>

      <!-- Paneles Administrativos -->
      <div class="solution-card">
        <div class="card-inner">
          <div class="card-icon">
            <i class="bi bi-speedometer2"></i>
            <div class="icon-bg"></div>
          </div>
          <div class="card-content">
            <h3 class="card-title">Paneles Administrativos</h3>
            <p class="card-description">
              Control total de tu negocio con dashboards intuitivos para gestionar usuarios, ventas, stock y más.
            </p>
            <ul class="card-features">
              <li><i class="bi bi-check-circle"></i> Dashboard Interactivo</li>
              <li><i class="bi bi-check-circle"></i> Reportes en Tiempo Real</li>
              <li><i class="bi bi-check-circle"></i> Multi-usuario</li>
            </ul>
          </div>
          <div class="card-hover-effect"></div>
        </div>
      </div>

      <!-- Aplicaciones de Escritorio -->
      <div class="solution-card">
        <div class="card-inner">
          <div class="card-icon">
            <i class="bi bi-pc-display-horizontal"></i>
            <div class="icon-bg"></div>
          </div>
          <div class="card-content">
            <h3 class="card-title">Aplicaciones de Escritorio</h3>
            <p class="card-description">
              Sistemas offline robustos, ideales para negocios que requieren velocidad y funcionamiento local.
            </p>
            <ul class="card-features">
              <li><i class="bi bi-check-circle"></i> Funcionamiento Offline</li>
              <li><i class="bi bi-check-circle"></i> Alta Velocidad</li>
              <li><i class="bi bi-check-circle"></i> Seguridad Local</li>
            </ul>
          </div>
          <div class="card-hover-effect"></div>
        </div>
      </div>

      <!-- Software a Medida -->
      <div class="solution-card">
        <div class="card-inner">
          <div class="card-icon">
            <i class="bi bi-boxes"></i>
            <div class="icon-bg"></div>
          </div>
          <div class="card-content">
            <h3 class="card-title">Software a Medida</h3>
            <p class="card-description">
              Soluciones personalizadas desde cero, ajustadas exactamente a los procesos de tu negocio.
            </p>
            <ul class="card-features">
              <li><i class="bi bi-check-circle"></i> 100% Personalizado</li>
              <li><i class="bi bi-check-circle"></i> Escalable</li>
              <li><i class="bi bi-check-circle"></i> Soporte Continuo</li>
            </ul>
          </div>
          <div class="card-hover-effect"></div>
        </div>
      </div>

      <!-- Análisis y Reportes -->
      <div class="solution-card">
        <div class="card-inner">
          <div class="card-icon">
            <i class="bi bi-graph-up-arrow"></i>
            <div class="icon-bg"></div>
          </div>
          <div class="card-content">
            <h3 class="card-title">Análisis y Reportes</h3>
            <p class="card-description">
              Visualizá el rendimiento con reportes claros, métricas clave y estadísticas automatizadas.
            </p>
            <ul class="card-features">
              <li><i class="bi bi-check-circle"></i> Business Intelligence</li>
              <li><i class="bi bi-check-circle"></i> Visualizaciones</li>
              <li><i class="bi bi-check-circle"></i> Datos en Tiempo Real</li>
            </ul>
          </div>
          <div class="card-hover-effect"></div>
        </div>
      </div>

    </div>

    <!-- CTA de la sección -->
    <div class="solutions-cta text-center" data-reveal>
      <h3 class="cta-title">¿No encontrás lo que buscás?</h3>
      <p class="cta-subtitle">Desarrollamos soluciones únicas para cada negocio</p>
      <a href="#contacto" class="btn-solutions-cta">
        <i class="bi bi-chat-dots"></i>
        Hablemos de tu proyecto
      </a>
    </div>
  </div>
  
  <!-- Gradiente de transición inferior -->
  <div class="gradient-fade-bottom"></div>
</section>
