---
import "../styles/solutions-section.css";
---

<section id="soluciones" class="solutions-section section-transition">
  <!-- Gradiente de transición superior -->
  <div class="gradient-fade-top"></div>
  
  <!-- Background decorativo -->
  <div class="solutions-bg">
    <div class="bg-pattern"></div>
    <div class="floating-shapes">
      <div class="shape shape-1"></div>
      <div class="shape shape-2"></div>
      <div class="shape shape-3"></div>
    </div>
  </div>

  <div class="container">
    <!-- Header de la sección -->
    <div class="solutions-header text-center" data-reveal-stagger>
      <div class="section-badge">
        <i class="bi bi-lightning-charge"></i>
        <span>Qué hacemos</span>
      </div>
      
      <h2 class="section-title">
        Esto es lo que
        <span class="text-gradient">hacemos</span>
      </h2>
      
      <p class="section-subtitle">
        Casi todo lo que hacemos son sistemas que ordenan la administración de un
        negocio. Hay tres formas de empezar.
      </p>
    </div>

    <!-- Grid de soluciones -->
    <div class="solutions-grid" data-reveal-stagger>

      <!-- Sistemas de gestión a medida -->
      <div class="solution-card">
        <div class="card-inner">
          <div class="card-icon">
            <i class="bi bi-diagram-3"></i>
            <div class="icon-bg"></div>
          </div>
          <div class="card-content">
            <h3 class="card-title">Sistemas de gestión a medida</h3>
            <p class="card-description">
              Armamos el sistema según cómo trabaja tu negocio: socios y cuotas, stock,
              ventas, facturación. Sin funciones que no vas a usar.
            </p>
            <ul class="card-features">
              <li><i class="bi bi-check-circle"></i> Control de stock e inventario</li>
              <li><i class="bi bi-check-circle"></i> Cobros, cuotas y facturación</li>
              <li><i class="bi bi-check-circle"></i> Reportes de tu negocio</li>
            </ul>
          </div>
          <div class="card-hover-effect"></div>
        </div>
      </div>

      <!-- Productos listos para usar -->
      <div class="solution-card">
        <div class="card-inner">
          <div class="card-icon">
            <i class="bi bi-box-seam"></i>
            <div class="icon-bg"></div>
          </div>
          <div class="card-content">
            <h3 class="card-title">Productos listos para usar</h3>
            <p class="card-description">
              Tres sistemas que ya desarrollamos y hoy funcionan en clientes nuestros.
              Los ponés a andar enseguida, sin esperar un desarrollo desde cero.
            </p>
            <ul class="card-features">
              <li><i class="bi bi-check-circle"></i> Ficus, gestión para comercios</li>
              <li><i class="bi bi-check-circle"></i> QRest, para bares y restaurantes</li>
              <li><i class="bi bi-check-circle"></i> Inventory Desktop, para escritorio</li>
            </ul>
            <a href="/productos" class="card-link">
              Conocer los productos
              <i class="bi bi-arrow-right"></i>
            </a>
          </div>
          <div class="card-hover-effect"></div>
        </div>
      </div>

      <!-- Sitios web -->
      <div class="solution-card">
        <div class="card-inner">
          <div class="card-icon">
            <i class="bi bi-globe2"></i>
            <div class="icon-bg"></div>
          </div>
          <div class="card-content">
            <h3 class="card-title">Sitios web</h3>
            <p class="card-description">
              Sitios rápidos, que se ven bien en el celular y que aparecen cuando
              te buscan en Google.
            </p>
            <ul class="card-features">
              <li><i class="bi bi-check-circle"></i> Diseño adaptado a celulares</li>
              <li><i class="bi bi-check-circle"></i> Optimizado para Google</li>
              <li><i class="bi bi-check-circle"></i> Carga rápida</li>
            </ul>
          </div>
          <div class="card-hover-effect"></div>
        </div>
      </div>

    </div>

    <!-- CTA de la sección -->
    <div class="solutions-cta text-center" data-reveal>
      <h3 class="cta-title">¿Tu caso es distinto?</h3>
      <p class="cta-subtitle">Contanos qué necesitás y lo evaluamos sin costo</p>
      <a href="#contacto" class="btn-solutions-cta">
        <i class="bi bi-chat-dots"></i>
        Hablemos de tu proyecto
      </a>
    </div>
  </div>
  
  <!-- Gradiente de transición inferior -->
  <div class="gradient-fade-bottom"></div>
</section>
