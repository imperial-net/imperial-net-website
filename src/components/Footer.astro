---
import "../styles/footer.css";
const isHome = Astro.url.pathname === "/";
const base = isHome ? "" : "/";
---

<footer class="footer">
  <div class="container">
    <!-- Sección principal del footer -->
    <div class="footer-main">
      <div class="row" data-reveal-stagger>
        <!-- Columna de la empresa -->
        <div class="col-lg-4 col-md-6 mb-4">
          <div class="footer-brand">
            <h3 class="brand-title">
              <img
                src="/img/logo-imperialnet.webp"
                alt=""
                class="brand-logo"
                width="40"
                height="44"
                loading="lazy"
                decoding="async"
              />
              Imperial Net
            </h3>
            <p class="brand-description">
              Transformamos ideas en soluciones tecnológicas que impulsan el crecimiento 
              de tu negocio. Software a medida, desarrollo web y automatización de procesos.
            </p>
            <div class="brand-features">
              <div class="feature-item">
                <i class="bi bi-check-circle"></i>
                <span>Desarrollo a medida</span>
              </div>
              <div class="feature-item">
                <i class="bi bi-check-circle"></i>
                <span>Soporte continuo</span>
              </div>
              <div class="feature-item">
                <i class="bi bi-check-circle"></i>
                <span>Tecnología moderna</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Columna de servicios -->
        <div class="col-lg-2 col-md-6 mb-4">
          <div class="footer-section">
            <h4 class="section-title">Servicios</h4>
            <ul class="footer-links">
              <li><a href={`${base}#soluciones`}>Sistemas de gestión</a></li>
              <li><a href="/productos">Productos listos para usar</a></li>
              <li><a href={`${base}#soluciones`}>Sitios web</a></li>
            </ul>
          </div>
        </div>

        <!-- Columna de empresa -->
        <div class="col-lg-2 col-md-6 mb-4">
          <div class="footer-section">
            <h4 class="section-title">Empresa</h4>
            <ul class="footer-links">
              <li><a href={`${base}#nosotros`}>Sobre nosotros</a></li>
              <li><a href="/productos">Productos</a></li>
              <li><a href={`${base}#blog`}>Blog</a></li>
              <li><a href={`${base}#faq`}>FAQ</a></li>
              <li><a href={`${base}#contacto`}>Contacto</a></li>
              <li><a href={`${base}#testimonials`}>Testimonios</a></li>
            </ul>
          </div>
        </div>

        <!-- Columna de contacto -->
        <div class="col-lg-4 col-md-6 mb-4">
          <div class="footer-section">
            <h4 class="section-title">Contacto</h4>
            <div class="contact-info">
              <div class="contact-item">
                <i class="bi bi-envelope"></i>
                <div class="contact-details">
                  <span class="contact-label">Email</span>
                  <a href="mailto:info@imperial-net.com">info@imperial-net.com</a>
                </div>
              </div>
              <div class="contact-item">
                <i class="bi bi-whatsapp"></i>
                <div class="contact-details">
                  <span class="contact-label">WhatsApp</span>
                  <a href="https://wa.me/5492392556779" target="_blank">+54 9 2392 55-6779</a>
                </div>
              </div>
              <div class="contact-item">
                <i class="bi bi-geo-alt"></i>
                <div class="contact-details">
                  <span class="contact-label">Ubicación</span>
                  <span>Argentina</span>
                </div>
              </div>
            </div>

            <!-- Redes sociales -->
            <div class="social-links">
              <h5 class="social-title">Síguenos</h5>
              <div class="social-buttons">
            
                <a href="https://wa.me/5492392556779" target="_blank" class="social-btn whatsapp">
                  <i class="bi bi-whatsapp"></i>
                </a>
                <a href="mailto:info@imperial-net.com" class="social-btn email">
                  <i class="bi bi-envelope"></i>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Separador -->
    <hr class="footer-divider">

    <!-- Footer bottom -->
    <div class="footer-bottom">
      <div class="row align-items-center">
        <div class="col-md-6">
          <p class="copyright">
            © 2026 <strong>Imperial Net</strong>. Todos los derechos reservados.
          </p>
        </div>
        <div class="col-md-6">
          <div class="footer-badges">
            <span class="badge location-badge">
              <i class="bi bi-geo-alt"></i>
              Trenque Lauquen, Buenos Aires, Argentina
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Fondo decorativo -->
  <div class="footer-background">
    <div class="bg-pattern"></div>
  </div>
</footer>

