---
import "../../public/css/cta-section.css";
---

<section id="empezar" class="cta-section section-transition">
  <!-- Gradiente de transición superior -->
  <div class="gradient-fade-top"></div>
  
  <div class="container">
    <!-- Background decorativo -->
    <div class="cta-background">
      <div class="floating-elements">
        <div class="floating-element element-1"></div>
        <div class="floating-element element-2"></div>
        <div class="floating-element element-3"></div>
        <div class="floating-element element-4"></div>
      </div>
    </div>

    <div class="row justify-content-center">
      <div class="col-lg-10 text-center" data-reveal-stagger>
        <!-- Badge superior -->
        <div class="cta-badge">
          <i class="bi bi-rocket-takeoff"></i>
          <span>¡Es hora de actuar!</span>
        </div>

        <!-- Título principal -->
        <h2 class="cta-title">
          ¿Listo para transformar
          <span class="text-gradient">tu negocio</span>?
        </h2>

        <!-- Subtítulo -->
        <p class="cta-subtitle">
          Cada día sin digitalizar es tiempo y dinero que perdés. Contanos tu proyecto
          y te mostramos cómo la tecnología puede trabajar para vos.
        </p>

        <!-- Estadísticas rápidas -->
        <div class="cta-stats">
          <div class="stat-item">
            <div class="stat-number">24h</div>
            <div class="stat-label">Respuesta</div>
          </div>
          <div class="stat-item">
            <div class="stat-number">100%</div>
            <div class="stat-label">A medida</div>
          </div>
          <div class="stat-item">
            <div class="stat-number"><span class="infinite">∞</span> </div>
            <div class="stat-label">Soporte</div>
          </div>
        </div>

        <!-- Botones de acción -->
      <div class="cta-buttons">
        <a href="#contacto" class="btn-primary-cta smooth-scroll">
          <i class="bi bi-send-fill"></i>
          Empezar mi proyecto
        </a>
        <a href="https://wa.me/5492392556779?text=Hola,%20quiero%20información%20sobre%20sus%20servicios" target="_blank" class="btn-whatsapp-cta">
          <i class="bi bi-whatsapp"></i>
          Escribir por WhatsApp
        </a>
      </div>
        <!-- Nota final -->
        <p class="cta-note">
          <i class="bi bi-patch-check"></i> <strong>Consulta gratuita:</strong> Analizamos tu caso sin compromiso
        </p>
      </div>
    </div>
  </div>
  
  <!-- Gradiente de transición inferior -->
  <div class="gradient-fade-bottom"></div>
</section>


<script>
  // Smooth scroll específico para CTASection
  document.addEventListener('DOMContentLoaded', function() {
    const smoothScrollBtn = document.querySelector('.btn-primary-cta');
    
    if (smoothScrollBtn) {
      smoothScrollBtn.addEventListener('click', function(e) {
        e.preventDefault();
        
        const targetElement = document.querySelector('#contacto');
        if (targetElement) {
          targetElement.scrollIntoView({
            behavior: 'smooth',
            block: 'start'
          });
        }
      });
    }
  });
</script>

