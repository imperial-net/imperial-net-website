<script>
  // Smooth scroll específico para CTASection
  document.addEventListener('DOMContentLoaded', function() {
    const smoothScrollBtn = document.querySelector('.btn-primary-cta');
    
    if (smoothScrollBtn) {
      smoothScrollBtn.addEventListener('click', function(e) {
        e.preventDefault();
        
        const targetElement = document.querySelector('#contacto');
        if (targetElement) {
          targetElement.scrollIntoView({
            behavior: 'smooth',
            block: 'start'
          });
        }
      });
    }
  });
</script>

